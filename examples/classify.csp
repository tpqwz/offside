#include <stdio.h>

int sign(int n):
    if (n < 0):
        return -1
    else if (n > 0):
        return 1
    else:
        return 0

const char *name(int n):
    switch (n):
        case 1:
            return "one"
        case 2:
            return "two"
        default:
            return "other"

int main(void):
    printf("%d %s\n", sign(-4), name(1))
    printf("%d %s\n", sign(0), name(2))
    printf("%d %s\n", sign(8), name(9))
    return 0
